# Safe defaults. Never commit secret keys or admin tokens.
APP_PORT=3000
TRADING_MODE=simulation
SOLANA_CLUSTER=devnet
TARGET_MULTIPLE=2
TARGET_PROCEEDS_BRL=195
INITIAL_CAPITAL_BRL=100
MAX_SLIPPAGE_BPS=100
AUTO_LAUNCH_ENABLED=false
AUTO_SELL_ENABLED=false
TOKEN_CREATION_ENABLED=false
# To enable test-token creation ONLY on Devnet, set these in hosting secrets:
# TRADING_MODE=devnet
# TOKEN_CREATION_ENABLED=true
# ADMIN_API_TOKEN=<long random secret>
# SOLANA_DEVNET_SECRET_KEY=<JSON byte array from a dedicated Devnet-only wallet>
# SOLANA_RPC_URL=https://api.devnet.solana.com
